# Local Python regression helpers
__pycache__/

# Converted attack sheets are source inputs, not disposable build output.
!graphics/ptd_attacks/*.4bpp

/include/constants/map_event_inputs.txt

# Pokemon Mystery Dungeon art is NOT distributed. Generate it from your own
# PMD Red Rescue Team ROM with tools/import_pmd_mons.py and tools/import_pmd_attacks.py.
graphics/pmd_mons/
graphics/pmd_attacks/
src/data/pmd_mon_graphics.h
src/data/realtime_ptd_graphics.h
src/data/realtime_ptd_emitters.h
# The Fly picture is built from FireRed's own maps and is shipped.
!graphics/fly_atlas/*

